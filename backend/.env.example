# Database Configuration
# For SQLite (default - development)
DATABASE_URL="file:./dev.db"

# For PostgreSQL (production - recommended)
# DATABASE_URL="postgresql://user:password@localhost:5432/xclone?schema=public"

# Optional: Custom database path for seeding
# DATABASE_PATH="/absolute/path/to/dev.db"

# Server Configuration
PORT=3000

# CORS (comma-separated origins)
CORS_ORIGINS="http://localhost:3001,http://localhost:3000"
